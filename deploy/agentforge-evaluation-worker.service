[Unit]
Description=AgentForge trusted evaluation worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=agentforge-artifacts
UMask=0027
WorkingDirectory=@RELEASE_DIR@
EnvironmentFile=@ENV_FILE@
ExecStart=@NODE_BIN@ --experimental-strip-types scripts/evaluation-worker-production.ts
Restart=on-failure
RestartSec=5s
TimeoutStopSec=180s
KillSignal=SIGTERM
KillMode=mixed
Delegate=yes
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
