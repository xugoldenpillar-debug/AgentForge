DATABASE_URL=postgres://agentforge:agentforge_local@localhost:5432/agentforge
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
APP_ENV=development
# Only APP_ENV=test may enable the offline model for isolated tests.
DEMO_MODE=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AI_GATEWAY_API_KEY=
PLATFORM_MODEL=
# Leave unknown prices empty. Never guess them.
PLATFORM_INPUT_PRICE_PER_MILLION=
PLATFORM_OUTPUT_PRICE_PER_MILLION=
# Comma-separated exact hosts that administrators trust for real BYOK requests.
# All resolved addresses must be public. Local/private addresses remain forbidden.
PROVIDER_ALLOWED_HOSTS=api.openai.com,openrouter.ai
RUN_MAX_TOTAL_COST=2.50
RUN_MAX_CASES=50
# Must be the exact string true to enable. Unset, 1, yes, and TRUE stay off.
# Enablement also needs Node ≥22.19.0. Default tests and CI never call paid models.
PI_RUNTIME_ENABLED=false
# Optional local PI3 Flash sample against the stored BYOK credential. Not used by pnpm test or CI.
# PI_RUNTIME_LIVE=true
# Comma-separated emails that may run the on-page Pi self-test. Others see an apply prompt.
# PI_RUNTIME_INVITED_EMAILS=you@example.com

# Artifact Arena remains fail-closed until durable artifact storage, sandbox,
# CreationRun Evaluation Foundation, and moderation providers pass their Gates.
ARTIFACT_ARENA_ENABLED=false
ARTIFACT_ARENA_KILL_SWITCH=false
