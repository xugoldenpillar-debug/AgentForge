DATABASE_URL=postgres://agentforge:agentforge_local@localhost:5432/agentforge
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
DEMO_MODE=true
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AI_GATEWAY_API_KEY=
PLATFORM_MODEL=
# Leave unknown prices empty. Never guess them.
PLATFORM_INPUT_PRICE_PER_MILLION=
PLATFORM_OUTPUT_PRICE_PER_MILLION=
# Comma-separated exact hosts that administrators trust for real BYOK requests.
# All resolved addresses must be public. Local/private addresses remain forbidden.
PROVIDER_ALLOWED_HOSTS=api.openai.com,openrouter.ai
RUN_MAX_TOTAL_COST=2.50
RUN_MAX_CASES=50
SEED_DEMO_ACCOUNT=true
# Development ONLY. The seed refuses a well-known demo login outside DEMO_MODE.
DEMO_EMAIL=demo@agentforge.local
DEMO_PASSWORD=ForgeDemo!2026
