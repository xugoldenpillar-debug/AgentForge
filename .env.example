DATABASE_URL=postgres://agentforge:agentforge_local@localhost:5432/agentforge
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
APP_ENV=development
# Only APP_ENV=test may enable the offline model for isolated tests.
DEMO_MODE=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AI_GATEWAY_API_KEY=
PLATFORM_MODEL=
# Leave unknown prices empty. Never guess them.
PLATFORM_INPUT_PRICE_PER_MILLION=
PLATFORM_OUTPUT_PRICE_PER_MILLION=
# Comma-separated official or operator-trusted hosts.
# Set true to let users enter any public HTTPS provider hostname. DNS is still checked on every connection; private/reserved addresses and redirects remain blocked.
PROVIDER_ALLOW_CUSTOM_HOSTS=true
PROVIDER_ALLOWED_HOSTS=api.openai.com,api.anthropic.com,generativelanguage.googleapis.com,api.deepseek.com,openrouter.ai
RUN_MAX_TOTAL_COST=2.50
RUN_MAX_CASES=50
# Must be the exact string true to enable. Unset, 1, yes, and TRUE stay off.
# Enablement also needs Node ≥22.19.0. Default tests and CI never call paid models.
PI_RUNTIME_ENABLED=false
# Optional local PI3 Flash sample against the stored BYOK credential. Not used by pnpm test or CI.
# PI_RUNTIME_LIVE=true
# Comma-separated emails that may run the on-page Pi self-test. Others see an apply prompt.
# PI_RUNTIME_INVITED_EMAILS=you@example.com

# Local development stays fail-closed by default. Production launch uses the
# complete host configuration documented in .env.worker.example.
ARTIFACT_ARENA_ENABLED=false
ARTIFACT_ARENA_KILL_SWITCH=false
# EVALUATION_SCHEDULER_MODE=outbox
# REDIS_URL=redis://127.0.0.1:6379/0
# EVALUATION_QUEUE_NAME=agentforge-evaluations
# EVALUATION_QUEUE_PREFIX=agentforge-development
# EVALUATION_WORKER_ID=development-worker-1
# SANDBOX_RUNSC_PATH=/usr/local/bin/runsc
# SANDBOX_ROOTFS=/opt/agentforge/rootfs
# SANDBOX_WORK_ROOT=/var/lib/agentforge/sandboxes
# SANDBOX_OCI_TEMPLATE=/opt/agentforge/oci-template.json
# SANDBOX_IMAGE_DIGEST=sha256:9db7b59979c38555a39def84a31fb98b5296952f9e3afd4f6f11f05b07adfab0
# ARTIFACT_STORAGE_ROOT=/var/lib/agentforge/artifacts
# ARTIFACT_STORAGE_GID=987
