# Copy to an operator-managed environment file; never commit the populated file.
# The worker requires explicit durable scheduling and never falls back to memory.
NODE_ENV=production
APP_ENV=production
DEMO_MODE=false
EVALUATION_SCHEDULER_MODE=outbox

DATABASE_URL=postgres://replace-user:replace-password@replace-db-host:5432/agentforge
REDIS_URL=redis://replace-redis-host:6379/0
CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Queue identity must be shared by the web scheduler and worker fleet.
EVALUATION_QUEUE_NAME=agentforge-evaluations
EVALUATION_QUEUE_PREFIX=agentforge
EVALUATION_WORKER_ID=replace-with-unique-worker-identity

# Operational controls; these do not define product quotas.
EVALUATION_WORKER_CONCURRENCY=1
EVALUATION_WORKER_LEASE_TTL_MS=60000
EVALUATION_WORKER_POLL_INTERVAL_MS=250
EVALUATION_WORKER_RECONCILIATION_INTERVAL_MS=5000
EVALUATION_WORKER_RECONCILIATION_BATCH_SIZE=50
EVALUATION_PUBLISHER_LEASE_TTL_MS=30000
EVALUATION_PUBLISHER_BATCH_SIZE=50
EVALUATION_QUEUE_READINESS_TIMEOUT_MS=1000
EVALUATION_QUEUE_COMPLETED_RETENTION_SECONDS=86400
EVALUATION_QUEUE_FAILED_RETENTION_SECONDS=604800

PROVIDER_ALLOWED_HOSTS=api.openai.com,openrouter.ai
RUN_MAX_TOTAL_COST=2.50
RUN_MAX_CASES=50
# Optional platform gateway configuration. Leave both empty when unused.
AI_GATEWAY_API_KEY=
PLATFORM_MODEL=
PLATFORM_INPUT_PRICE_PER_MILLION=
PLATFORM_OUTPUT_PRICE_PER_MILLION=
