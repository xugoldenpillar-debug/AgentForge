# Shared production environment for the Next.js web container and the trusted
# host worker. Copy outside the checkout, chmod 0600, and replace placeholders.
NODE_ENV=production
APP_ENV=production
DEMO_MODE=false
EVALUATION_SCHEDULER_MODE=outbox
ARTIFACT_ARENA_ENABLED=true
ARTIFACT_ARENA_KILL_SWITCH=false
PI_RUNTIME_ENABLED=true

DATABASE_URL=postgres://replace-user:replace-password@replace-db-host:5432/agentforge
REDIS_URL=redis://127.0.0.1:6379/0
BETTER_AUTH_URL=https://arena.example.com
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=replace-with-canonical-base64-encoded-32-byte-key

# Queue identity is shared by the web outbox producer and worker fleet.
EVALUATION_QUEUE_NAME=agentforge-evaluations
EVALUATION_QUEUE_PREFIX=agentforge-production
EVALUATION_WORKER_ID=hubei-worker-1
EVALUATION_WORKER_CONCURRENCY=1
EVALUATION_WORKER_LEASE_TTL_MS=60000
EVALUATION_WORKER_POLL_INTERVAL_MS=250
EVALUATION_WORKER_RECONCILIATION_INTERVAL_MS=5000
EVALUATION_WORKER_RECONCILIATION_BATCH_SIZE=50
EVALUATION_PUBLISHER_LEASE_TTL_MS=30000
EVALUATION_PUBLISHER_BATCH_SIZE=50
EVALUATION_QUEUE_READINESS_TIMEOUT_MS=1000
EVALUATION_QUEUE_COMPLETED_RETENTION_SECONDS=86400
EVALUATION_QUEUE_FAILED_RETENTION_SECONDS=604800

# Trusted host-only runsc environment. The sandbox itself has no network.
SANDBOX_RUNSC_PATH=/usr/local/bin/runsc
SANDBOX_ROOTFS=/opt/agentforge/rootfs
SANDBOX_WORK_ROOT=/var/lib/agentforge/sandboxes
SANDBOX_OCI_TEMPLATE=/opt/agentforge/oci-template.json
SANDBOX_IMAGE_DIGEST=sha256:9db7b59979c38555a39def84a31fb98b5296952f9e3afd4f6f11f05b07adfab0

# Dedicated immutable filesystem store. Set this to the numeric GID created for
# agentforge-artifacts; the worker writes 0640 and the web container mounts read-only.
ARTIFACT_STORAGE_ROOT=/var/lib/agentforge/artifacts
ARTIFACT_STORAGE_GID=replace-with-agentforge-artifacts-numeric-gid

# Exact public provider API hosts accepted for user-selected BYOK protocols.
# Supported protocol shapes: OpenAI Chat, OpenAI Responses, Anthropic Messages,
# and Google Generative AI. Add custom OpenAI-compatible hosts only after review.
PROVIDER_ALLOWED_HOSTS=api.openai.com,api.anthropic.com,generativelanguage.googleapis.com,api.deepseek.com,openrouter.ai

# These limits belong to the legacy deterministic DAG track. The animation BYOK
# launch does not impose a platform USD model-spend cap in this release.
RUN_MAX_TOTAL_COST=2.50
RUN_MAX_CASES=50

# Optional platform model remains disabled for the BYOK-first launch.
AI_GATEWAY_API_KEY=
PLATFORM_MODEL=
PLATFORM_INPUT_PRICE_PER_MILLION=
PLATFORM_OUTPUT_PRICE_PER_MILLION=
